<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.waywallen-cycler" path="/org/gnome/shell/extensions/waywallen-cycler/">
        <key name="next-wallpaper" type="as">
            <default><![CDATA[['<Control><Shift>Right']]]></default>
            <summary>Siguiente fondo</summary>
            <description>Pasar al siguiente fondo de Waywallen</description>
        </key>
        <key name="prev-wallpaper" type="as">
            <default><![CDATA[['<Control><Shift>Left']]]></default>
            <summary>Fondo anterior</summary>
            <description>Volver al fondo anterior de Waywallen</description>
        </key>
        <key name="show-osd" type="b">
            <default>true</default>
            <summary>Mostrar OSD</summary>
            <description>Mostrar cartel abajo al cambiar de fondo</description>
        </key>
        <key name="show-notification" type="b">
            <default>true</default>
            <summary>Mostrar notificación</summary>
            <description>Mostrar burbuja arriba al cambiar de fondo</description>
        </key>
    </schema>
</schemalist>